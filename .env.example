# ===== Royal Blackjack — Environment Config =====
# Copy this to .env and fill in your values

# Server port (default: 3000)
PORT=3000

# Your frontend URL for CORS
CLIENT_URL=http://localhost:5500

# DATABASE CONFIGURATION
# For production with PostgreSQL (Render):
#   DATABASE_URL=postgresql://user:password@db.render.com:5432/casino_db
# For local development with SQLite:
#   Leave DATABASE_URL empty or commented out
DATABASE_URL=

# AUTHENTICATION
# CHANGE THESE in production — use long random strings (32+ chars)
JWT_SECRET=royal-blackjack-jwt-secret-change-me-in-production-32-chars-min
REFRESH_TOKEN_SECRET=royal-blackjack-refresh-secret-change-me-in-production-32-chars-min

# Token expiration times
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# GAME SETTINGS
DEFAULT_DECKS=6
MIN_BET=100
MAX_BET=50000

# NODE ENVIRONMENT
NODE_ENV=production
